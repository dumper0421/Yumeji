[
  { "id": "Haru_01", "speaker": "하루", "lines": [{ "text": "뭔가… 눈에 익는 느낌인데… ", "showPortrait": true }] },

  { "id": "HaruRey1_01", "speaker": "레이", "lines": [{ "text": "저기! 같이 가!", "showPortrait": true, "nextId": "HaruRey1_02" }] },
  { "id": "HaruRey1_02", "speaker": "하루", "lines": [{ "text": "응?", "showPortrait": true }] },

  { "id": "HaruRey1_03", "speaker": "레이", "lines": [{ "text": "같이 가자고.", "showPortrait": true, "nextId": "HaruRey1_04" }] },
  { "id": "HaruRey1_04", "speaker": "레이", "lines": [{ "text": "여기 처음이잖아, 그치?", "showPortrait": true, "nextId": "HaruRey1_05" }] },
  { "id": "HaruRey1_05", "speaker": "레이", "lines": [{ "text": "아까 빌려준 답례로 내가 안내해 줄게.", "showPortrait": true, "nextId": "HaruRey1_06" }] },

  { "id": "HaruRey1_06", "speaker": "하루", "lines": [{ "text": "괜찮은데… 나도 주소는 알고 있어.", "showPortrait": true, "nextId": "HaruRey1_07" }] },

  { "id": "HaruRey1_07", "speaker": "레이", "lines": [{ "text": "무인역인데 사람도 없어서 분위기가 좀 무섭단 말이지.", "showPortrait": true, "nextId": "HaruRey1_08" }] },
  { "id": "HaruRey1_08", "speaker": "레이", "lines": [{ "text": "도심에서 멀리 떨어져 있어서 원래 한적하긴 한데…", "showPortrait": true, "nextId": "HaruRey1_09" }] },
  { "id": "HaruRey1_09", "speaker": "레이", "lines": [{ "text": "오늘은 유독 개미 한 마리 안 보이네.", "showPortrait": true, "nextId": "HaruRey1_10" }] },
  { "id": "HaruRey1_10", "speaker": "레이", "lines": [{ "text": "어때, 같이 가자. 응?", "showPortrait": true, "nextId": "HaruRey1_11" }] },

  { "id": "HaruRey1_11", "speaker": "하루", "lines": [{ "text": "…뭐, 상관없어.", "showPortrait": true ,"nextId": "HaruRey1_12" }] },
  { "id": "HaruRey1_12", "speaker": "하루", "lines": [{ "text": "근데 어차피 나가는 길은 하나인데.", "showPortrait": true ,"nextId": "HaruRey1_13" }] },
  { "id": "HaruRey1_13", "speaker": "레이", "lines": [{ "text": "저기 이름이 뭐야? 난 레이. 잘 부탁해.", "showPortrait": true ,"nextId": "HaruRey1_14" }] },
  { "id": "HaruRey1_14", "speaker": "하루", "lines": [{ "text": "레이…? 난 하루. 잘 부탁해.", "showPortrait": true  }] },

  { "id": "HaruRey1_15", "speaker": "하루", "lines": [{ "text": "이상한 역이네… 이렇게 사람이 없고 낡은 역은 처음 봐.", "showPortrait": true, "nextId": "HaruRey1_16" }]},
  { "id": "HaruRey1_16", "speaker": "레이", "lines": [{ "text": "흐응, 오늘 유독 이상하다니까.", "showPortrait": true, "nextId": "HaruRey1_17" }]},
  { "id": "HaruRey1_17", "speaker": "레이", "lines": [{ "text": "개찰구도 먹통인 것 같고.", "showPortrait": true, "nextId": "HaruRey1_18" }]},
  { "id": "HaruRey1_18", "speaker": "레이", "lines": [{ "text": "우리… 그냥 넘어갈까?", "showPortrait": true, "nextId": "HaruRey1_19" }]},
  { "id": "HaruRey1_19", "speaker": "하루", "lines": [{ "text": "에이, 그래도 그건 좀…", "showPortrait": true, "nextId": "HaruRey1_20" }]},
  { "id": "HaruRey1_20", "speaker": "레이", "lines": [{ "text": "시간 아깝지 않아?", "showPortrait": true, "nextId": "HaruRey1_21" }]},
  { "id": "HaruRey1_21", "speaker": "레이", "lines": [{ "text": "연회에 늦으면 어떡해.", "showPortrait": true }]},
  {
    "id": "HaruRey1_22",
    "speaker": "레이",
    "lines": [
      { "text": "뭔가 이상해.", "showPortrait": true, "nextId": "HaruRey1_23" }
    ]
  },
  {
    "id": "HaruRey1_23",
    "speaker": "레이",
    "lines": [
      { "text": "왜 문이 잠겨 있지? 분명 오늘 초대받았는데.", "showPortrait": true, "nextId": "HaruRey1_24" }
    ]
  },
  {
    "id": "HaruRey1_24",
    "speaker": "하루",
    "lines": [
      { "text": "연회장이 여기가 맞는 거야?", "showPortrait": true, "nextId": "HaruRey1_25" }
    ]
  },
  {
    "id": "HaruRey1_25",
    "speaker": "레이",
    "lines": [
      { "text": "맞아. 확실해.", "showPortrait": true, "nextId": "HaruRey1_26" }
    ]
  },
  {
    "id": "HaruRey1_26",
    "speaker": "하루",
    "lines": [
      { "text": "잠시만… 근데 나도 오려던 곳이 여기 같은데.", "showPortrait": true, "nextId": "HaruRey1_27" }
    ]
  },
  {
    "id": "HaruRey1_27",
    "speaker": "레이",
    "lines": [
      { "text": "뭐라고?", "showPortrait": true, "nextId": "HaruRey1_28" }
    ]
  },
  {
    "id": "HaruRey1_28",
    "speaker": "하루",
    "lines": [
      { "text": "음, 주소 보니까 이 안쪽이 폐촬영장이라고 되어 있는데…", "showPortrait": true, "nextId": "HaruRey1_29" }
    ]
  },
  {
    "id": "HaruRey1_29",
    "speaker": "하루",
    "lines": [
      { "text": "들어갈 방법이 없네.", "showPortrait": true, "nextId": "HaruRey1_30" }
    ]
  },
  {
    "id": "HaruRey1_30",
    "speaker": "하루",
    "lines": [
      { "text": "벨도 없고, 사람 기척도 안 들려.", "showPortrait": true, "nextId": "HaruRey1_31" }
    ]
  },
  {
    "id": "HaruRey1_31",
    "speaker": "레이",
    "lines": [
      { "text": "아! 내가 들어가는 길을 알아.", "showPortrait": true, "nextId": "HaruRey1_32" }
    ]
  },
  {
    "id": "HaruRey1_32",
    "speaker": "레이",
    "lines": [
      { "text": "정원 쪽으로 돌아가면 작은 영사실이 하나 있던 걸로 기억해.", "showPortrait": true, "nextId": "HaruRey1_33" }
    ]
  },
  {
    "id": "HaruRey1_33",
    "speaker": "레이",
    "lines": [
      { "text": "영사실로 가면 내부로 들어갈 수 있을 거야.", "showPortrait": true, "nextId": "HaruRey1_34" }
    ]
  },
  {
    "id": "HaruRey1_34",
    "speaker": "하루",
    "lines": [
      { "text": "영사실?", "showPortrait": true, "nextId": "HaruRey1_35" }
    ]
  },
  {
    "id": "HaruRey1_35",
    "speaker": "레이",
    "lines": [
      { "text": "응, 여기 호텔 주인이 곳곳에 개인 영화관 같은 방을 많이 만들어 놨다고 했거든.", "showPortrait": true, "nextId": "HaruRey1_36" }
    ]
  },
  {
    "id": "HaruRey1_36",
    "speaker": "레이",
    "lines": [
      { "text": "외부랑 연결된 영사실이 정원 안쪽에 있을 거야.", "showPortrait": true, "nextId": "HaruRey1_37" }
    ]
  },
  {
    "id": "HaruRey1_37",
    "speaker": "하루",
    "lines": [
      { "text": "여기 처음 온 거 아니었어?", "showPortrait": true, "nextId": "HaruRey1_38" }
    ]
  },
  {
    "id": "HaruRey1_38",
    "speaker": "하루",
    "lines": [
      { "text": "어떻게 그렇게 잘 알아?", "showPortrait": true, "nextId": "HaruRey1_39" }
    ]
  },
  {
    "id": "HaruRey1_39",
    "speaker": "레이",
    "lines": [
      { "text": "연회에 기다리고 있는 사람이 많아, 빨리 따라와!", "showPortrait": true }
    ]
  }
]
