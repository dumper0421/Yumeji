[
  { "id": "HaruRei1_1", "speaker": "레이", "lines": [{ "text": "저기.", "showPortrait": true, "nextId": "HaruRei1_2" }] },
  { "id": "HaruRei1_2", "speaker": "하루", "lines": [{ "text": "...응?", "showPortrait": true, "nextId": "HaruRei1_3" }] },

  { "id": "HaruRei1_3", "speaker": "레이", "lines": [{ "text": "저기, 뭐 듣고 있어?", "showPortrait": true, "nextId": "HaruRei1_4" }] },
  { "id": "HaruRei1_4", "speaker": "하루", "lines": [{ "text": "아, 그냥 옛날 노래요. 평소에 자주 듣는 거.", "showPortrait": true, "nextId": "HaruRei1_5" }] },
  { "id": "HaruRei1_5", "speaker": "레이", "lines": [{ "text": "흐응, 그렇구나. 노래가 전부 새어 나오고 있길래.", "showPortrait": true, "nextId": "HaruRei1_6" }] },
  { "id": "HaruRei1_6", "speaker": "하루", "lines": [{ "text": "아... 죄송해요.", "showPortrait": true, "nextId": "HaruRei1_7" }] },
  { "id": "HaruRei1_7", "speaker": "레이", "lines": [{ "text": "근데 그 기계는 뭐야? 그걸로 노래를 듣는 거야?", "showPortrait": true, "nextId": "HaruRei1_8" }] },
  { "id": "HaruRei1_8", "speaker": "하루", "lines": [{ "text": "네, 요즘은 잘 안 쓰긴 하죠.", "showPortrait": true, "nextId": "HaruRei1_9" }] },
  { "id": "HaruRei1_9", "speaker": "레이", "lines": [{ "text": "처음 보는데, 예쁘다.", "showPortrait": true, "nextId": "HaruRei1_10" }] },

  { "id": "HaruRei1_10", "speaker": "레이", "lines": [{ "text": "근데 너, 종점까지 가?", "showPortrait": true, "nextId": "HaruRei1_11" }] },
  { "id": "HaruRei1_11", "speaker": "레이", "lines": [{ "text": "다른 사람들은 아까 전부 내렸는데, 너만 안 내리길래.", "showPortrait": true, "nextId": "HaruRei1_12" }] },
  { "id": "HaruRei1_12", "speaker": "하루", "lines": [{ "text": "네, 거기 가야 할 곳이 있어서요. 그쪽은요?", "showPortrait": true, "nextId": "HaruRei1_13" }] },
  { "id": "HaruRei1_13", "speaker": "레이", "lines": [{ "text": "내 옷 보면 모르겠어?", "showPortrait": true, "nextId": "HaruRei1_14" }] },
  { "id": "HaruRei1_14", "speaker": "레이", "lines": [{ "text": "오늘 열리는 연회에 가는 거잖아.", "showPortrait": true, "nextId": "HaruRei1_15" }] },
  { "id": "HaruRei1_15", "speaker": "하루", "lines": [{ "text": "거기에서 연회를 하는 곳이 있어요?", "showPortrait": true, "nextId": "HaruRei1_16" }] },
  { "id": "HaruRei1_16", "speaker": "하루", "lines": [{ "text": "아직도 그쪽에 연회를 할 만한 장소가 있어요?", "showPortrait": true, "nextId": "HaruRei1_17" }] },
  { "id": "HaruRei1_17", "speaker": "레이", "lines": [{ "text": "모른다고? 너도 거기 가는 거 아니었어?", "showPortrait": true, "nextId": "HaruRei1_18" }] },
  { "id": "HaruRei1_18", "speaker": "레이", "lines": [{ "text": "도착하면 바로 보이는 호텔에서 하는 연회 말이야.", "showPortrait": true, "nextId": "HaruRei1_19" }] },
  { "id": "HaruRei1_19", "speaker": "하루", "lines": [{ "text": "아닌데요? 저는 누구 찾을 사람이 있어서.", "showPortrait": true, "nextId": "HaruRei1_20" }] },
  { "id": "HaruRei1_20", "speaker": "하루", "lines": [{ "text": "호텔에서 연회라니... 처음 듣는 이야기인데.", "showPortrait": true, "nextId": "HaruRei1_21" }] },

  { "id": "HaruRei1_21", "speaker": "레이", "lines": [{ "text": "이쪽이 더 신기한데. 파티에 가지도 않으면서 같이 종점까지 가는 거였다니.", "showPortrait": true, "nextId": "HaruRei1_22" }] },
  { "id": "HaruRei1_22", "speaker": "레이", "lines": [{ "text": "그러면 너도 같이 가지 않을래?", "showPortrait": true, "nextId": "HaruRei1_23" }] },
  { "id": "HaruRei1_23", "speaker": "레이", "lines": [{ "text": "나, 한 명까지는 같이 데려갈 수 있어.", "showPortrait": true, "nextId": "HaruRei1_24" }] },
  { "id": "HaruRei1_24", "speaker": "하루", "lines": [{ "text": "예? 저는 괜찮아요.", "showPortrait": true, "nextId": "HaruRei1_25" }] },
  { "id": "HaruRei1_25", "speaker": "하루", "lines": [{ "text": "그런 화려한 자리는 가본 적도 없고, 지금은 누군가를 찾는 게 더 급해서요.", "showPortrait": true, "nextId": "HaruRei1_26" }] },
  { "id": "HaruRei1_26", "speaker": "레이", "lines": [{ "text": "뭐, 알겠어.", "showPortrait": true, "nextId": "HaruRei1_27" }] },
  { "id": "HaruRei1_27", "speaker": "레이", "lines": [{ "text": "그러면... 그 기계, 내가 좀 들어도 돼?", "showPortrait": true, "nextId": "HaruRei1_28" }] },
  { "id": "HaruRei1_28", "speaker": "레이", "lines": [{ "text": "가는 데 너무 심심해서.", "showPortrait": true, "nextId": "HaruRei1_29" }] },
  { "id": "HaruRei1_29", "speaker": "하루", "lines": [{ "text": "뭐... 그러세요.", "showPortrait": true }] },

  { "id": "HaruRei1_30", "speaker": "하루", "lines": [{ "text": "이상한 여자네...", "showPortrait": true, "nextId": "HaruRei1_31" }] },
  { "id": "HaruRei1_31", "speaker": "기장", "lines": [{ "text": "승객 여러분. 우리 열차는 곧 터널에 진입합니다.", "showPortrait": false, "nextId": "HaruRei1_32" }] },
  { "id": "HaruRei1_32", "speaker": "기장", "lines": [{ "text": "실내가 어두워지니 발 밑을 주의하시기 바랍니다.", "showPortrait": false}] },

  { "id": "HaruRei1_33", "speaker": "하루", "lines": [{ "text": "저기, 다 도착했는데...", "showPortrait": true, "nextId": "HaruRei1_34" }] },
  { "id": "HaruRei1_34", "speaker": "레이", "lines": [{ "text": "...응? 벌써?", "showPortrait": true,"nextId":"HaruRei1_35"}] },

  { "id": "HaruRei1_35", "speaker": "레이", "lines": [{ "text": "잘 들었어. 사실 자느라 거의 못 듣긴 했지만.", "showPortrait": true, "nextId": "HaruRei1_36" }] },
  { "id": "HaruRei1_36", "speaker": "하루", "lines": [{ "text": "...에휴, 뭐. 그럼 먼저 가볼게요.", "showPortrait": true, "nextId": "" }] },
   { "id": "HaruCantOut", "speaker": "하루", "lines": [{ "text": "그래도 깨워야겠지... 돌려받을 것도 있고.", "showPortrait": false, "nextId": "" }] },
   { "id": "HaruRepeat", "speaker": "레이", "lines": [{ "text": "곧 따라 나갈게.", "showPortrait": true, "nextId": "" }] }
]
