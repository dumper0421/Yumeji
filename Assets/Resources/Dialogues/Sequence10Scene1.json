  {
    "id": "stay_1",
    "speaker": "하루",
    "lines": [
      { "text": "알아.", "showPortrait": true },
      { "text": "그래도 한 번만 더…… 너랑 같이 보고 싶은 게 있어.", "showPortrait": true, "nextId": "stay_2" }
    ]
  },
  {
    "id": "stay_2",
    "speaker": "루나",
