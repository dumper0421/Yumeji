    "lines": [
      { "text": "이제 가, 하루.", "showPortrait": true },
      { "text": "아직 나갈 수 있어.", "showPortrait": true },
      { "text": "여기까지 와줘서 고마워.", "showPortrait": true, "nextId": "c2_2" }
    ]
  },
  {
    "id": "c2_2",
    "speaker": "하루",
    "lines": [
      { "text": "……아직 남아 있잖아.", "showPortrait": true, "nextId": "c2_3" }
    ]
  },
  {
    "id": "c2_3",
    "speaker": "루나",
    "lines": [
