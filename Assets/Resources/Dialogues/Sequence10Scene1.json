  },
  {
    "id": "c3_2",
    "speaker": "루나",
    "lines": [
      { "text": "안 돼.", "showPortrait": true },
      { "text": "지금 다시 들어가면 너도 같이 휩쓸려.", "showPortrait": true, "nextId": "c3_3" }
