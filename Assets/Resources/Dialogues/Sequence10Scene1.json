  },
  {
    "id": "c3_3",
    "speaker": "하루",
    "lines": [
      { "text": "…", "showPortrait": true, "nextId": "c3_4" }
    ]
  },
  {
    "id": "c3_4",
    "speaker": "루나",
    "lines": [
      { "text": "다시 돌아오지 못할 거야.", "showPortrait": true }
    ],
    "options": [
      { "text": "루나와 함께 남는다.", "nextId": "stay_1", "hasIntermediateAction": true },
      { "text": "현실로 돌아간다.", "nextId": "leave_1", "hasIntermediateAction": true }
