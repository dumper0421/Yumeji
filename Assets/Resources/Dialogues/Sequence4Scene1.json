[
  {
    "id": "HotelEntrance_Haru_OpeningMonologue",
    "speaker": "하루",
    "lines": [
      { "text": "가끔 기억이 필름과도 같다는 생각이 들기도 한다.", "showPortrait": false },
      { "text": "어둠 속에서 꺼내려는 순간, 빛을 받아 타버리고 만다.", "showPortrait": false, "nextId": "HotelEntrance_Haru_AskLuna" }
    ]
  },
  {
    "id": "HotelEntrance_Haru_AskLuna",
    "speaker": "하루",
    "lines": [
      { "text": "루나, 이번 영화에서 맡는 배역 이름이 뭐라고 했지?", "showPortrait": false, "nextId": "HotelEntrance_Luna_Reply" }
    ]
  },
  {
    "id": "HotelEntrance_Luna_Reply",
    "speaker": "루나",
    "lines": [
      { "text": "뭐야, 또 까먹었어?", "showPortrait": false, "nextId": "HotelEntrance_Haru_TryRemember" }
    ]
  },
  {
    "id": "HotelEntrance_Haru_TryRemember",
    "speaker": "하루",
    "lines": [
      { "text": "잠시만! 알려주지 말아봐. 기억해볼게.", "showPortrait": false },
      { "text": "그…", "showPortrait": false },
      { "text": "…", "showPortrait": false },
      { "text": "…….", "showPortrait": false, "nextId": "HotelEntrance_WakeNarration" }
    ]
  },
  {
    "id": "HotelEntrance_WakeNarration",
    "speaker": "",
    "lines": [
      { "text": "서서히 눈을 뜨는 하루. 화려한 바로크 풍 로비 입구. 레이가 그를 내려다보고 있다.", "showPortrait": false, "nextId": "HotelEntrance_Ray_First" }
    ]
  },
  {
    "id": "HotelEntrance_Ray_First",
    "speaker": "레이",
    "lines": [
      { "text": "얼른 가자. 다들 기다려.", "showPortrait": true, "nextId": "HotelEntrance_Haru_Confused" }
    ]
  },
  {
    "id": "HotelEntrance_Haru_Confused",
    "speaker": "하루",
    "lines": [
      { "text": "방금까지… 분명 영사실이었는데. 여기 어디야?", "showPortrait": true, "nextId": "HotelEntrance_Ray_AskInvite" }
    ]
  },
  {
    "id": "HotelEntrance_Ray_AskInvite",
    "speaker": "레이",
    "lines": [
      { "text": "무슨 소릴 하는 거야. 초대장은 잘 챙겼지?", "showPortrait": true, "nextId": "HotelEntrance_Haru_AskInvite" }
    ]
  },
  {
    "id": "HotelEntrance_Haru_AskInvite",
    "speaker": "하루",
    "lines": [
      { "text": "초대장? 무슨 초대장…?", "showPortrait": true, "nextId": "HotelEntrance_Ray_Strange" }
    ]
  },
  {
    "id": "HotelEntrance_Ray_Strange",
    "speaker": "레이",
    "lines": [
      { "text": "갑자기 왜 이래?", "showPortrait": true },
      { "text": "주머니에 아까 넣어 뒀잖아. 잘 확인해봐.", "showPortrait": true, "nextId": "HotelEntrance_Haru_Silent" }
    ]
  },
  {
    "id": "HotelEntrance_Haru_Silent",
    "speaker": "하루",
    "lines": [
      { "text": "…", "showPortrait": true, "nextId": "HotelEntrance_Ray_Party" }
    ]
  },
  {
    "id": "HotelEntrance_Ray_Party",
    "speaker": "레이",
    "lines": [
      { "text": "연회라면 이제 지겹지만, 오늘 밤은 왠지 기대가 되네.", "showPortrait": true },
      { "text": "자, 들어가자. 너무 늦는 건 예의가 아니니까.", "showPortrait": true, "nextId": "HotelEntrance_CheckInvitePrompt" }
    ]
  },
  {
    "id": "HotelEntrance_CheckInvitePrompt",
    "speaker": "하루",
    "lines": [
      { "text": "(인벤토리에서 초대장을 한번 확인해보자.)", "showPortrait": false }
    ]
  },
  {
    "id": "HotelEntrance_StaffNarration",
    "speaker": "",
    "lines": [
      { "text": "하루가 쭈뼛거리며 연회장 입구의 직원에게 종이를 건넨다. 직원의 목 부분에 봉제선이 나 있다.", "showPortrait": false, "nextId": "HotelEntrance_Hotelier" }
    ]
  },
  {
    "id": "HotelEntrance_Hotelier",
    "speaker": "호텔리어",
    "lines": [
      { "text": "귀한 발걸음 해주셔서 감사합니다.", "showPortrait": true },
      { "text": "<유메지>에 오신 것을 환영합니다.", "showPortrait": true },
      { "text": "초대장은 제가 보관하도록 하겠습니다.", "showPortrait": true },
      { "text": "이쪽으로 들어가시면 되겠습니다.", "showPortrait": true },
      { "text": "당신의 역할을 잃어버리지 마시길 바랍니다.", "showPortrait": true, "nextId": "HotelEntrance_Ray_Final" }
    ]
  },
  {
    "id": "HotelEntrance_Ray_Final",
    "speaker": "레이",
    "lines": [
      { "text": "들어가자!", "showPortrait": true}
    ]
  },
   {
    "id": "LobbyDoor",
    "lines": [
      { "text": "문이 굳게 잠겨 있다. 지금은 열리지 않을 것 같다.!", "showPortrait": false}
    ]
  },
   {
    "id": "NoInvitation",
    "speaker":"하루",
    "lines": [
      { "text": "초대장을 직원에게 먼저 보여줘야 할 것 같다.", "showPortrait": false}
    ]
  },
     {
    "id": "Already_Hotelier",
    "speaker":"호텔리어",
    "lines": [
      { "text": "이쪽으로 들어가시면 되겠습니다.", "showPortrait": true}
    ]
  }
]